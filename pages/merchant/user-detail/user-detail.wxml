<view class="detail-container">
  <!-- 顶端：画像与概览 -->
  <view class="summary-card">
    <view class="user-main-row">
      <view class="name-box">
        <text class="user-name">{{ player.name }}</text>
        <text class="user-phone">📱 {{ player.phone }}</text>
      </view>
      <button size="mini" class="push-coupon-btn" bindtap="giveExclusiveCoupon">派发专属券</button>
    </view>

    <view class="stats-grid">
      <view class="stat-box">
        <text class="stat-num">￥{{ stats.totalSpent }}</text>
        <text class="stat-label">累计消费净额</text>
      </view>
      <view class="stat-box">
        <text class="stat-num">{{ stats.verifiedCount }} 次</text>
        <text class="stat-label">已核销履约</text>
      </view>
      <view class="stat-box">
        <text class="stat-num">{{ stats.totalOrders }} 笔</text>
        <text class="stat-label">总预约订单</text>
      </view>
    </view>

    <!-- 偏好套餐画像 -->
    <view class="tags-section">
      <text class="tag-title">常玩套餐：</text>
      <view class="tags-list">
        <text class="tag-item" wx:for="{{ stats.historyPackages }}" wx:key="*this">{{ item }}</text>
        <text wx:if="{{ stats.historyPackages.length === 0 }}" class="tag-empty">暂无常玩记录</text>
      </view>
    </view>
  </view>

  <!-- 底部列表：该用户全量消费订单 -->
  <view class="list-section">
    <view class="section-title">该用户所有历史订单 ({{ orders.length }})</view>
    <view class="order-card" wx:for="{{ orders }}" wx:key="id">
      <view class="order-top">
        <text class="order-pkg">{{ item.package_name || item.package }}</text>
        <text class="badge {{ item.status === '待核销' ? 'tag-pending' : (item.status === '部分退款' ? 'tag-partial' : (item.status === '已核销' ? 'tag-done' : 'tag-refund')) }}">{{ item.status }}</text>
      </view>
      <view class="order-meta">
        <view class="row"><text class="k">预约时段：</text>{{ item.booking_time || item.time }} ({{ item.people_count || 1 }}人)</view>
        <view class="row"><text class="k">体验地点：</text>{{ item.location }}</view>
        <view class="row"><text class="k">订单原付：</text>￥{{ item.amount }}</view>
        <view class="row"><text class="k">退款金额：</text><text class="refund-val">￥{{ item.refunded_amount || item.refundedAmount || 0 }}</text></view>
        <view class="row full"><text class="k">预约码：</text><text class="code-val">{{ item.code }}</text></view>
      </view>

      <!-- 核心联动：部分退款与待核销订单保留操作动作 -->
      <view class="order-action-bar" wx:if="{{ item.status === '待核销' || item.status === '部分退款' }}">
        <button size="mini" class="act-btn refund-btn" bindtap="handleDetailRefund" data-item="{{ item }}">继续退款</button>
        <button size="mini" class="act-btn verify-btn" bindtap="handleDetailVerify" data-code="{{ item.code }}">核销此单</button>
      </view>
    </view>
    <view wx:if="{{ orders.length === 0 }}" class="empty-tip">该玩家尚无订单明细</view>
  </view>
</view>